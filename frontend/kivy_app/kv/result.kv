#:import dp kivy.metrics.dp

<ResultScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(16)
        spacing: dp(10)
        Label:
            text: root.summary
            font_size: '26sp'
            bold: True
            size_hint_y: None
            height: dp(70)
        ScrollView:
            Label:
                text: root.details
                markup: True
                size_hint_y: None
                height: self.texture_size[1]
                text_size: self.width, None
        GBtn:
            text: 'Menyu'
            on_release: app.root.current = 'menu'
